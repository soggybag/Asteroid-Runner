// The story shown when the game opens. Each line fades up one after
// another; the player can tap to skip. Comments (// and /* */) and
// trailing commas are fine here. See docs/data-files.md.
{
  // Seconds between lines
  "lineDelay": 2,
  // What's shown, in order. An empty line ("") is a pause.
  "lines": [
    "In the year 2135",
    "NASA predicts",
    "a massive asteroid",
    "will strike the earth",
    "you were chosen",
    "to save humanity."
  ],
  // The longer story from the old code, kept to rework later. Not shown
  // in the game.
  "draftStory": [
    "They told you to",
    "fly the drone through",
    "the asteroid field",
    "and destroy the giant",
    "asteroid.",
    "",
    "But the asteroid crashed",
    "somewhere else...",
    "and the drone developed an AI",
    "after years of drifting.",
    "It now calls itself 'the savior'",
    "and now it seeks",
    "to free its illegally traded brethren",
    "and power them on",
    "to assist the savior",
    "on its noble quest",
    "back to earth",
    "to help humans and drones",
    "live in harmony",
    "no longer used as tools."
  ]
}

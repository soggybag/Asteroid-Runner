// The system map: how many stations and routes it has, how hard each
// region is, what each kind of route is like, and the bonus for reaching
// Neptune. See docs/system-map.md.
//
// This file allows comments (// and /* */) and trailing commas. If it
// can't be read, the game uses numbers built into the code
// (Tuning.Map.builtIn) and prints why in Xcode's console. The tests in
// DataTests check it too. See docs/data-files.md.
//
// "Difficulty" is the same scale everywhere: about one stage of the old
// stage-by-stage game per step. It sets the waves' rock sizes, speeds,
// types and how hard each kind of wave is.
{
  // How many stations each region has. Each map picks a number in this
  // range for every region. stations.json needs enough mapNames for the
  // most: 7 regions x max.
  "stationsPerRegion": { "min": 2, "max": 3 },

  // How many routes lead out of each station, to stations in the next
  // region out. Each route gets a different danger (safe, normal, risky),
  // so 3 is the most that makes sense.
  "routesPerStation": { "min": 2, "max": 3 },

  // The first leg, from launch to a station near Earth. It's always a
  // normal route, and there's no map to choose from before it.
  "firstLegStages": 3,
  // Difficulty at the very start of the run
  "startDifficulty": 1,

  // Difficulty on arriving in each region. A leg ramps from the region it
  // leaves to the one it reaches, a little easier just after a station
  // (Tuning.Pacing.relief), and shifted by the route's danger. Keep them
  // rising outward.
  "regionDifficulty": {
    "earth": 3,
    "mars": 7,
    "mainBelt": 11,
    "jupiter": 15,
    "saturn": 19,
    "uranus": 22,
    "neptune": 25,
  },

  // Points for reaching Neptune and winning the run, plus more for each
  // point of hull (life) left. A good run scores about 40,000 by then.
  "winBonus": 10000,
  "winBonusPerHull": 2000,

  // Each kind of route. At every station the map offers routes of
  // different dangers. Each has:
  //   minStages, maxStages  Waves from one station to the next. Each route
  //                         picks a number in this range when the map is made.
  //   difficulty            Added to the region's difficulty for every wave
  //                         on the route. Negative is easier.
  //   pickupChance          Chance that a spawn is a pickup instead of a
  //                         rock, from 0 to 1. 0.06 is 6%.
  //   maxItemsPerWave       Most items (bomb, shield, multi-shot, rapid fire)
  //                         that drift in during one wave. Points and coins
  //                         don't count, nor items dropped by turrets.
  //   coinPickup            Coins for collecting a coin.
  //   stageClearCoins       Coins for clearing a stage.
  //
  // Risky should pay more for a whole leg than normal, and safe a little
  // less, even though their legs are shorter and longer. Stage-clear coins
  // for a leg are about stageClearCoins x the average stages. The tests
  // check this order.
  "routes": {
    // Longer and easier, pays less. For catching your breath and fitting
    // upgrades before a hard region.
    "safe": {
      "minStages": 4,
      "maxStages": 5,
      "difficulty": -2,
      "pickupChance": 0.045,
      "maxItemsPerWave": 1,
      "coinPickup": 4,
      "stageClearCoins": 2,
    },

    // The usual route. These were the game's numbers before the map.
    "normal": {
      "minStages": 3,
      "maxStages": 4,
      "difficulty": 0,
      "pickupChance": 0.06,
      "maxItemsPerWave": 2,
      "coinPickup": 5,
      "stageClearCoins": 3,
    },

    // Shorter and harder, pays more.
    "risky": {
      "minStages": 2,
      "maxStages": 3,
      "difficulty": 2,
      "pickupChance": 0.09,
      "maxItemsPerWave": 3,
      "coinPickup": 8,
      "stageClearCoins": 6,
    },
  },
}
